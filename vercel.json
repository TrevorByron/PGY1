{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/questionnaire/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/questionnaire",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/questionnaire/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
